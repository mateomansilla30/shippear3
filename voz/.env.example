# Copiá este archivo como .env y completá las claves. El .env NO se sube al repo.
GROQ_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=      # respaldo de la voz
GEMINI_API_KEY=      # opcional

# WhatsApp (Kapso): la API key del proyecto y el número de prueba que recibe los audios
KAPSO_API_KEY=
KAPSO_DESTINO=       # con código de país, sin + ni espacios: 5491112345678
# KAPSO_PHONE_NUMBER_ID=   # si falta, se usa el primer número de la cuenta (el del sandbox)

# Interpretación con LLM (OpenAI)
# INTERPRETAR_CON_LLM=1
# LLM_MODELO=gpt-4.1-mini

# Opcionales
# TTS_PROVEEDOR=elevenlabs      # elevenlabs | openai | gemini
# TTS_RESPALDO=openai           # elevenlabs | openai | gemini | ninguno
